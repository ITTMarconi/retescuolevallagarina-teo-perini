---
import OpenDaysList from "../../components/OpenDaysList.astro";

import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Icon from "../../components/Icon.astro";
// @ts-ignore - Module works correctly at runtime, TypeScript language server can't resolve types
import { readItem } from "@directus/sdk";
import directus from "../../lib/directus";
import { type components } from "../../types/schema";
import { SCHOOL_DETAIL_FIELDS, detailLogoUrl, buildAssetUrl } from "../../lib/directus-queries";

const { id } = Astro.params;

const INSTITUTE = (await directus.request(
  readItem("schools", id as string, {
    // @ts-ignore - Directus SDK accepts nested field selectors but TypeScript doesn't recognize them
    fields: SCHOOL_DETAIL_FIELDS as unknown as string[],
  })
)) as components["schemas"]["ItemsSchools"];

const assetUrl = (fileId: string | null | undefined) =>
  fileId ? `${buildAssetUrl(fileId)}` : null;

// Ensure videos is an array we can iterate safely
const VIDEOS = Array.isArray(INSTITUTE.videos)
  ? INSTITUTE.videos.filter((v: any) => v && typeof v !== "string")
  : [];
---

<Layout>
  <Navbar />

  <main>
    <header>
      <h2 class="font-regular">{INSTITUTE.name}</h2>
      <hr />

      <section>
        <img
          src={typeof INSTITUTE.logo === "string" ? buildAssetUrl(INSTITUTE.logo) : detailLogoUrl(INSTITUTE.logo?.id)}
          alt={`${typeof INSTITUTE.logo === "string" ? "Logo" : INSTITUTE.logo?.title}`}
        />

        <nav>
          <a href={INSTITUTE.website_url} target="_blank">
            <Icon code="f728" color="var(--foreground-secondary)" />
            <span>{INSTITUTE.website_url}</span>
          </a>

          <a
            href={`https://www.google.com/maps/search/?api=1&query=${INSTITUTE.address}`}
            target="_blank"
          >
            <Icon code="e0c8" color="var(--foreground-secondary)" />
            <span>{INSTITUTE.address}</span>
          </a>

          {
            typeof INSTITUTE.responsabile_orientamento === "string" &&
              INSTITUTE.responsabile_orientamento.length > 0 && (
                <div title="Responsabile orientamento">
                  <Icon code="e7fd" color="var(--foreground-secondary)" />
                  <span>
                    Responsabile orientamento:{" "}
                    {INSTITUTE.responsabile_orientamento}
                  </span>
                </div>
              )
          }
        </nav>
      </section>
    </header>
    {
      VIDEOS.length > 0 && (
        <section>
          <h2 class="font-regular">Video</h2>
          <hr />

          <div class="videos-grid">
            {VIDEOS.map((v: string | components["schemas"]["ItemsVideos"]) => {
              if (typeof v === "string") return null;
              return (
                <figure>
                  <figcaption>{v.title}</figcaption>
                  {v.video_file ? (
                    <video
                      src={assetUrl(
                        typeof v.video_file === "string"
                          ? v.video_file
                          : v.video_file?.id
                      )}
                      controls
                    />
                  ) : v.youtube_id ? (
                    <div class="youtube-wrapper">
                      <iframe
                        src={`https://www.youtube.com/embed/${v.youtube_id}`}
                        title={v.title || "YouTube video"}
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      />
                    </div>
                  ) : (
                    <p>No media available</p>
                  )}
                  {v.description && <p class="video-desc">{v.description}</p>}
                </figure>
              );
            })}
          </div>
        </section>
      )
    }
    <article>
      {
        typeof INSTITUTE.edu_links !== "string" &&
          INSTITUTE.edu_links &&
          INSTITUTE.edu_links.length > 0 && (
            <section>
              <h2 class="font-regular">Indirizzi</h2>
              <hr />

              <ul>
                {INSTITUTE.edu_links &&
                  INSTITUTE.edu_links.map(
                    (
                      indirizzo:
                        | string
                        | components["schemas"]["ItemsSchoolEducationalPathLinks"]
                    ) =>
                      typeof indirizzo !== "string" && (
                        <li>
                          <a href={indirizzo.link_url} target="_blank">
                            {indirizzo.name}
                          </a>
                        </li>
                      )
                  )}
              </ul>
            </section>
          )
      }

      {
        INSTITUTE.main_campus
          ? typeof INSTITUTE.branch_schools !== "string" &&
            INSTITUTE.branch_schools &&
            INSTITUTE.branch_schools.length > 0 && (
              <section>
                <h2 class="font-regular">Altre sedi</h2>
                <hr />

                <ul>
                  {INSTITUTE.branch_schools.map(
                    (sede: string | components["schemas"]["ItemsSchools"]) =>
                      typeof sede !== "string" && (
                        <li>
                          <a href={`/sede/${sede.id}`}>{sede.name}</a>
                        </li>
                      )
                  )}
                </ul>
              </section>
            )
          : typeof INSTITUTE.parent_school !== "string" &&
            INSTITUTE.parent_school && (
              <section>
                <h2 class="font-regular">Sede principale</h2>
                <hr />

                <li>
                  <a href={`/sede/${INSTITUTE.parent_school.id}`}>
                    {INSTITUTE.parent_school.name}
                  </a>
                </li>
              </section>
            )
      }

      {
        typeof INSTITUTE.events !== "string" && INSTITUTE.events && (
          <section>
            <h2 class="font-regular">Open day</h2>
            <hr />

            <OpenDaysList institute={INSTITUTE} />
          </section>
        )
      }
    </article>
  </main>

  <footer>
    <table>
      <th colspan="2"><div>E-Mails <hr /></div></th>
      {
        typeof INSTITUTE.school_emails !== "string" &&
          INSTITUTE.school_emails &&
          INSTITUTE.school_emails.map(
            (mail: string | components["schemas"]["ItemsSchoolEmails"]) =>
              typeof mail !== "string" && (
                <tr>
                  <td>{mail.label}</td>
                  <td>
                    <a href={`mailto:${mail.email}`}>{mail.email}</a>
                  </td>
                </tr>
              )
          )
      }
    </table>

    <table>
      <th colspan="2"> <div>Numeri di Telefono <hr /></div></th>
      {
        typeof INSTITUTE.school_phones !== "string" &&
          INSTITUTE.school_phones &&
          INSTITUTE.school_phones.map(
            (phone: string | components["schemas"]["ItemsSchoolPhones"]) =>
              typeof phone !== "string" && (
                <tr>
                  <td>{phone.label}</td>
                  <td>
                    <a href={`tel:${phone.number}`}>{phone.number}</a>
                  </td>
                </tr>
              )
          )
      }
    </table>
  </footer>
</Layout>

<style>
  main {
    padding: 1rem;
    width: 100%;
    max-width: 100vw;
    box-sizing: border-box;
    overflow-x: hidden;

    display: flex;
    flex-direction: column;
    align-items: center;
    flex-wrap: nowrap;

    gap: 3rem;
  }

  main > * {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Header */
  /* -------------------------------------------------------------------------------- */

  main > header {
    flex-basis: 100%;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;

    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  header > hr {
    width: 60%;
    max-width: calc(100% - 2rem);
  }

  header > h2 {
    width: 100%;

    padding: 0.8rem 0 0 0;

    font-size: 1.8rem;
    text-align: center;
  }

  header > section {
    width: 90%;
    max-width: 100%;
    box-sizing: border-box;

    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;

    flex-wrap: nowrap;
  }

  section > img {
    display: none;
  }

  nav > a,
  nav > div {
    padding: 0.2rem 0;

    border: unset;
    background-color: unset;

    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    box-sizing: border-box;
  }

  nav > a > span:last-child {
    text-decoration: underline;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  a > span:first-child,
  div > span:first-child {
    font-size: 2.5rem;
  }

  a > span:nth-child(2),
  div > span:nth-child(2) {
    font-size: 0.9rem;
  }

  /* Video */
  /* -------------------------------------------------------------------------------- */

  main > video {
    width: 100%;
  }

  /* Sezioni */
  /* -------------------------------------------------------------------------------- */

  main > article {
    padding: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  main > article > section {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  main > section {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  section > h2 {
    font-size: 1.4rem;
    text-transform: capitalize;
    padding: 0 1rem;
    box-sizing: border-box;
    text-align: center;
    width: 100%;
  }

  section > hr {
    width: 100%;
    max-width: 100%;
    margin: 0;
    box-sizing: border-box;
  }

  section > ul {
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: flex-start;
    flex-wrap: nowrap;
    line-height: 1.5rem;
    gap: 0.8rem;
    padding: 0 1rem 0 2rem;
    box-sizing: border-box;
    width: 100%;
    max-width: 40rem;
    list-style-type: disc;
    list-style-position: outside;
  }

  section > ul li {
    text-align: left;
    width: auto;
    padding-left: 0.5rem;
  }

  section > ul a {
    font-size: 1.2rem;
    text-decoration: underline;
  }

  /* Footer */
  /* -------------------------------------------------------------------------------- */

  footer {
    padding: 3rem 0 4rem 0;

    background-color: var(--background-secondary);
    color: black;

    display: flex;
    flex-wrap: nowrap;
    flex-direction: column;
    justify-content: space-evenly;
    gap: 2rem;
    overflow-x: hidden;
  }

  th {
    width: 100%;

    text-align: center;
    font-weight: 500;
  }

  th > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  tr > td {
    padding: 0.4rem 0.4rem;
    text-align: left;
  }

  tr > td:first-child {
    padding-right: 0.5rem;
    text-align: right;
  }

  tr > td:last-child {
    padding-left: 0.5rem;
  }

  footer hr {
    width: 12rem;

    color: var(--background-primary);
    border: 1.5px solid var(--background-primary);
  }

  footer a {
    text-decoration: underline;
  }

  /* Videos grid */
  .videos-grid {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr; /* 1 column on mobile */
    gap: 1.5rem;
    padding: 1rem;
  }

  .videos-grid figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .videos-grid figcaption {
    padding: 0 0 0.3rem 0;
    box-sizing: border-box;
    font-size: 1.3rem;
    font-weight: 400;
    color: inherit;
    line-height: 1.4;
  }

  /* Use aspect-ratio to keep videos responsive */
  .videos-grid video,
  .youtube-wrapper iframe {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    aspect-ratio: 16 / 9;
    height: auto;
    background: black;
    border: none;
  }

  .video-desc {
    font-size: 0.95rem;
    color: inherit;
  }

  /* On tablets and larger, show 2 columns */
  @media only screen and (min-width: 700px) {
    .videos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Queries */
  /* -------------------------------------------------------------------------------- */

  /* For tablets: */
  @media only screen and (min-width: 500px) {
    main {
      padding: 2rem;
    }

    div > h2 {
      font-size: 1.8rem;
    }

    nav > a,
    nav > div {
      padding: 0.4rem;
    }

    a > span:first-child,
    div > span:first-child {
      font-size: 2.4rem;
    }

    /*******/

    section > img {
      display: block;
      height: 12rem;

      border-radius: 0.8rem;
    }

    section > h2 {
      font-size: 1.6rem;
      text-transform: capitalize;
    }

    section > ul {
      max-width: 50rem;
    }

    main > section {
      margin: 0rem 0 2rem 0;
      flex-wrap: nowrap;
      flex-direction: column;
    }

    footer {
      padding: 3rem 0 2rem 0;
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
    }
  }

  /* For wide desktop: */
  @media only screen and (min-width: 1440px) {
    main > header {
      max-width: 70rem;
    }

    main > article {
      max-width: 70rem;
    }

    main > article > section {
      max-width: 65rem;
    }

    section > ul {
      max-width: 60rem;
    }

    main > section {
      max-width: 70rem;

      flex-direction: column;
      align-items: center;
      justify-content: space-between;
    }

    main > video {
      width: 45%;
    }
  }
</style>
