---
import {
  getDay,
  getMonth,
  getYear,
  getFullYear,
  getHours,
  getMinutes,
} from "../scripts/DateUtils";
import { type components } from "../types/schema";

interface Props {
  institute: components["schemas"]["ItemsSchools"];
}

let { institute } = Astro.props;

let openDays = institute.events;

if (!Array.isArray(openDays)) {
  openDays = [];
}
---

<section id={`open-days-list-${institute.miur_code}`}>
  {
    openDays
      .filter((orario: string | components["schemas"]["ItemsEvents"]) => {
        if (!orario || typeof orario === "string") return false;

        const now = new Date();
        const start = new Date(orario.start_date!);
        const currentYear = now.getFullYear();
        const startYear = start.getFullYear();
        const startMonth = start.getMonth() + 1; // JavaScript months are 0-indexed

        // Show events from September onwards in current year, or future events
        return (startMonth >= 9 && startYear === currentYear) || start > now;
      })
      .map((orario: string | components["schemas"]["ItemsEvents"]) => {
        if (!orario || typeof orario === "string") return null;

        const now = new Date();
        const start = new Date(orario.start_date!);
        const end = new Date(orario.end_date!);
        const className = start < now ? "past" : "future";

        return (
          <article data-orario={orario.start_date}>
            <time datetime={orario.start_date} class={className}>
              <span class="day">{getDay(start)}</span>
              <span class="date">
                {getMonth(start)}/{getYear(start)}
              </span>
            </time>

            <div class="event-details">
              <h3 class="event-title">
                {orario.title} - {getHours(start)}:{getMinutes(start)} -{" "}
                {getHours(end)}:{getMinutes(end)}
              </h3>
              <p class="event-description">
                <Fragment set:html={orario.description} />
              </p>
            </div>
          </article>
        );
      })
  }
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;

    gap: 2rem;
    padding: 1rem;
    width: 100%;
    max-width: 45rem;
    margin: 0 auto;
    box-sizing: border-box;
  }

  article {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    max-width: 40rem;

    gap: 1rem;
  }

  time {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Date badge */
  /* ******************************************************************************** */

  time {
    padding: 0.8rem 0.2rem;
    width: 3rem;

    color: var(--foreground-primary);

    border-radius: 2rem;

    align-items: center;
    gap: 0.1rem;
  }

  time .day {
    font-size: 1.8rem;
  }

  time .date {
    font-size: 1rem;
  }

  .past {
    background-color: var(--tint-red);
  }

  .future {
    background-color: var(--background-primary);
  }

  /* Event details */
  /* ******************************************************************************** */

  .event-details {
    flex-basis: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;

    gap: 0.5rem;
  }

  .event-title {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0;
  }

  .event-description {
    font-size: 1rem;
    line-height: 1.5rem;
    text-wrap: wrap;
    overflow-wrap: break-word;
    margin: 0;
  }

  /* For desktop: */
  @media only screen and (min-width: 768px) {
    section {
      max-width: 50rem;
    }

    article {
      max-width: 48rem;
    }

    time {
      height: 5rem;
      width: 5.5rem;

      padding: 0;

      border-radius: 4rem;
    }

    .event-description {
      max-width: 50ch;
    }
  }

  /* For wide-desktop: */
  @media only screen and (min-width: 1536px) {
  }
</style>
