---
// src/pages/routes.astro
import SchoolRoutesContainer from "../components/SchoolRoutesContainer.jsx";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Icon from "../components/Icon.astro";
import { PUBLIC_API_URL } from "astro:env/client";
import { readItems } from "@directus/sdk";
import directus from "../lib/directus";
import { fixObjectEncoding } from "../lib/utils";
import {
  TRANSPORT_ROUTE_FIELDS,
  SORT_ROUTES_BY_SCHOOL_NAME,
} from "../lib/directus-queries";

const routes = await directus.request(
  readItems("transport_routes", {
    fields: TRANSPORT_ROUTE_FIELDS as unknown as string[],
    sort: SORT_ROUTES_BY_SCHOOL_NAME as unknown as string[],
    limit: -1,
  })
);

// Fix encoding for all routes
const decodedRoutes = fixObjectEncoding(routes);

// Derive unique schools from transport_routes data (no separate schools query)
const schoolsMap = new Map<string, any>();
for (const route of decodedRoutes) {
  if (route.school?.id && !schoolsMap.has(route.school.id)) {
    schoolsMap.set(route.school.id, {
      id: route.school.id,
      name: route.school.name,
      logo: route.school.logo,
    });
  }
}
const schoolsWithRoutes = Array.from(schoolsMap.values());
---

<style>
  :global(body) {
    overflow-x: hidden;
    max-width: 100vw;
  }

  @media (max-width: 700px) {
    :global(.routes-container-wrapper) {
      flex-direction: column !important;
    }
    :global(.sidebar-wrapper) {
      width: 100% !important;
      order: 2;
      padding: 0.5rem !important;
    }
    :global(.main-content-wrapper) {
      order: 1;
      padding: 0.5rem !important;
    }
  }
</style>

<Layout title="Percorsi di Trasporto">
  <Navbar current_view="routes" />
  <SchoolRoutesContainer
    client:only="react"
    schools={schoolsWithRoutes}
    routes={decodedRoutes}
    apiUrl={PUBLIC_API_URL}
  />
</Layout>
