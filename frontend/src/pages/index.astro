---
import "../styles/common.css";

import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { PUBLIC_API_URL } from "astro:env/client";
import { readSingleton } from "@directus/sdk";
import directus from "../lib/directus";
import type { Schema, components } from "../types/schema";

type SiteSettings = components["schemas"]["ItemsSiteSettings"];
const site_settings = await directus.request<SiteSettings>(
  readSingleton("site_settings")
);
---

<Layout>
  <main>
    <h1 class="site-title">
      <span
        >{site_settings.site_title}
        <img
          src={`${PUBLIC_API_URL}/assets/${site_settings.site_logo}`}
          alt={`${site_settings.site_title} Logo`}
          srcset=""
        /></span
      >
    </h1>

    <Fragment set:html={site_settings.welcome_message} />

    <nav>
      <a href="/istituti/">
        <Icon code="e7ee" color="var(--foreground-secondary)" />
        <span>Istituti</span>
      </a>
      <a href="/calendar/" id="calendar">
        <Icon code="ebcc" color="var(--foreground-secondary)" />
        <span class="font-light">Calendario <br />Open Days</span>
      </a>
      <a href="/openday/" id="openday">
        <Icon code="e8ef" color="var(--foreground-secondary)" />
        <span class="font-light">Lista incontri e <br />Open Days</span>
      </a>
      <a href="/map/">
        <Icon code="e55b" color="var(--foreground-secondary)" />
        <span class="font-light">Mappa Scuole</span>
      </a>
      <!--
      <a href="/routes/">
        <Icon code="e52f" color="var(--foreground-secondary)" />
        <span class="font-light">Percorsi di Trasporto</span>
      </a>
      -->
    </nav>
  </main>
</Layout>

<style is:global>
  main > p {
    margin: 2rem 3rem 0rem;
    align-self: flex-start;
    font-size: 2.7rem;

    color: var(--foreground-secondary);
    text-align: left;
  }

  main > p > strong {
    color: var(--foreground-primary);
    font-weight: 900;
  }
</style>

<style>
  main {
    width: calc(100% - 2rem);
    min-height: calc(100% - 2.4rem);
    padding: 1.2rem 1rem;

    background-color: var(--background-primary);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: visible;
  }

  h1,
  h1 > span {
    align-self: flex-start;
    text-transform: uppercase;
    font-size: 1.8rem;
    text-align: left;
    color: var(--foreground-secondary);
    line-height: 1.5rem;
    margin-top: 0.6rem;
    margin-left: 0rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  h1 > span > img {
    margin: 0 0 0 0.4rem;
    height: 2rem;
  }

  nav {
    width: 100%;
    margin-top: 2rem;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;

    flex-direction: column;
    gap: 1em 4em;
  }

  a {
    text-align: center;
    margin: 0.5rem;

    display: flex;
    flex-direction: column;
    text-decoration-line: unset;
    overflow: visible;
  }

  a:hover span {
    color: var(--tint-orange);
  }

  nav span:first-child {
    font-size: 8rem;
    color: var(--foreground-secondary);
  }
  nav span:last-child {
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--foreground-secondary);
  }

  /* For tablets: */
  @media only screen and (min-width: 600px) {
    main {
      overflow: visible;
      padding: 2rem 1rem;
    }
    nav {
      flex-direction: row;
      margin-top: 1rem;
      overflow: visible;
      flex-wrap: wrap;
      gap: 0rem 3rem;
      align-items: flex-start;
    }
    a {
      margin: 1rem;
      overflow: visible;
    }
    /* Odd items positioned up */
    a:nth-child(odd) {
      align-self: flex-start;
    }
    /* Even items positioned down */
    a:nth-child(even) {
      align-self: flex-end;
      margin-top: 5rem;
    }
    nav span:first-child {
      font-size: 10rem;
      color: var(--foreground-secondary);
      transition: all 0.3s;
    }
    nav span:first-child:hover {
      color: var(--foreground-primary);
      transform: scale(1.1);
    }
    main > p {
      margin: 3rem 0rem;
      margin-left: 3rem;
      font-size: 2.7rem;
    }
    main > h1 {
      margin-left: 3rem;
    }
  }

  /* For desktop: */
  @media only screen and (min-width: 768px) {
    main {
      padding: 1.2rem 1rem;
    }
    nav {
      height: 50%;
      margin-top: 3rem;
      gap: 0rem 4rem;
      align-items: flex-start;
    }
    a {
      margin: 1.5rem;
    }
    /* Even items positioned down with more offset */
    a:nth-child(even) {
      margin-top: 6rem;
    }
    nav span:first-child {
      font-size: 12rem;
      color: var(--foreground-secondary);
    }
  }
</style>

<!-- JavaScript for enhanced touch handling -->
<script>
  const foregroundSecondary = getComputedStyle(
    document.documentElement
  ).getPropertyValue("--foreground-secondary");
  const foregroundPrimary = getComputedStyle(
    document.documentElement
  ).getPropertyValue("--foreground-primary");

  document.querySelectorAll("nav span:first-child").forEach((symbol) => {
    // Prevent default touch behavior
    // symbol.addEventListener('touchstart', (e) => {
    //        e.preventDefault();
    //   }, { passive: false });

    // Optional: Add custom touch feedback
    symbol.addEventListener("touchstart", function (this: HTMLElement) {
      this.style.transform = "scale(1.1)";
      this.style.color = foregroundPrimary;
    });

    symbol.addEventListener("touchend", function (this: HTMLElement) {
      this.style.transform = "scale(1)";
      this.style.color = foregroundSecondary;
    });
  });
</script>
