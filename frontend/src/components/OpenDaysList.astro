---
import {
  getDay,
  getMonth,
  getYear,
  getFullYear,
  getHours,
  getMinutes,
} from "../scripts/DateUtils";
import { type components } from "../types/schema";

interface Props {
  institute: components["schemas"]["ItemsSchools"];
}

let { institute } = Astro.props;

let openDays = institute.events;

if (!Array.isArray(openDays)) {
  openDays = [];
}
---

<section class="event-list" id={`open-days-list-${institute.miur_code}`}>
  {
    openDays
      .filter((orario: string | components["schemas"]["ItemsEvents"]) => {
        if (!orario || typeof orario === "string") return false;

        const now = new Date();
        const start = new Date(orario.start_date!);
        const currentYear = now.getFullYear();
        const startYear = start.getFullYear();
        const startMonth = start.getMonth() + 1; // JavaScript months are 0-indexed

        // Show events from September onwards in current year, or future events
        return (startMonth >= 9 && startYear === currentYear) || start > now;
      })
      .map((orario: string | components["schemas"]["ItemsEvents"]) => {
        if (!orario || typeof orario === "string") return null;

        const now = new Date();
        const start = new Date(orario.start_date!);
        const end = new Date(orario.end_date!);
        const className = start < now ? "past" : "future";

        return (
          <article data-orario={orario.start_date}>
            <time datetime={orario.start_date} class={className}>
              <span class="day">{getDay(start)}</span>
              <span class="date">
                {getMonth(start)}/{getYear(start)}
              </span>
            </time>

            <div class="event-details">
              <h3 class="event-title">
                {orario.title} - {getHours(start)}:{getMinutes(start)} -{" "}
                {getHours(end)}:{getMinutes(end)}
              </h3>
              <section class="event-description">
                <Fragment set:html={orario.description} />
              </section>
            </div>
          </article>
        );
      })
  }
</section>

<style>
  .event-list {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;

    gap: 1rem;
    padding: 1rem 0rem 0 0rem;
    width: 100%;
    max-width: 45rem;
    margin: 0 auto;
    box-sizing: border-box;
  }

  article {
    margin-top: 1rem;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    max-width: 40rem;
    overflow: hidden;

    gap: 1rem;
  }

  time {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Date badge */
  /* ******************************************************************************** */

  time {
    padding: 0.8rem 0.2rem;
    width: 3rem;

    color: var(--foreground-primary);

    border-radius: 2rem;

    align-items: center;
    gap: 0.1rem;
  }

  time .day {
    font-size: 1.8rem;
  }

  time .date {
    font-size: 1rem;
  }

  .past {
    background-color: var(--tint-red);
  }

  .future {
    background-color: var(--background-primary);
  }

  /* Event details */
  /* ******************************************************************************** */

  .event-details {
    flex-basis: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;

    gap: 0.5rem;
  }

  .event-title {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0;
    word-wrap: break-word;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
    width: 100%;
  }

  .event-description {
    font-size: 1rem;
    line-height: 1.5rem;
    text-wrap: wrap;
    overflow-wrap: break-word;
    word-break: break-word;
    margin: 0;
    width: 100%;
    max-width: 100%;
  }

  .event-description :global(*) {
    max-width: 100%;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Headings */
  .event-description :global(h1),
  .event-description :global(h2),
  .event-description :global(h3),
  .event-description :global(h4),
  .event-description :global(h5),
  .event-description :global(h6) {
    margin: 0.8rem 0 0.4rem 0;
    padding: 0;
    line-height: 1.3;
    font-weight: 600;
  }

  .event-description :global(h1) {
    font-size: 1.8rem;
  }

  .event-description :global(h2) {
    font-size: 1.5rem;
  }

  .event-description :global(h3) {
    font-size: 1.3rem;
  }

  .event-description :global(h4),
  .event-description :global(h5),
  .event-description :global(h6) {
    font-size: 1.1rem;
  }

  /* Paragraphs */
  .event-description :global(p) {
    margin: 0.2rem 0;
    padding: 0;
    line-height: 1.6;
  }

  .event-description :global(p:first-child) {
    margin-top: 0;
  }

  .event-description :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Links */
  .event-description :global(a) {
    color: inherit;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .event-description :global(a:hover) {
    color: var(--tint-orange);
  }

  /* Lists */
  .event-description :global(ul),
  .event-description :global(ol) {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
    line-height: 1.6;
  }

  .event-description :global(li) {
    margin: 0.3rem 0;
  }

  /* Strong and emphasis */
  .event-description :global(strong),
  .event-description :global(b) {
    font-weight: 700;
  }

  .event-description :global(em),
  .event-description :global(i) {
    font-style: italic;
  }

  /* Blockquotes */
  .event-description :global(blockquote) {
    margin: 0.8rem 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--tint-orange);
    font-style: italic;
  }

  /* Code */
  .event-description :global(code) {
    font-family: monospace;
    background-color: rgba(0, 0, 0, 0.05);
    padding: 0.1rem 0.3rem;
    border-radius: 0.2rem;
    font-size: 0.9em;
  }

  .event-description :global(pre) {
    margin: 0.8rem 0;
    padding: 0.8rem;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 0.3rem;
    overflow-x: auto;
  }

  .event-description :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  /* Media */
  .event-description :global(img),
  .event-description :global(video),
  .event-description :global(iframe) {
    max-width: 100%;
    height: auto;
  }

  /* For desktop: */
  @media only screen and (min-width: 768px) {
    section {
      max-width: 50rem;
    }

    article {
      max-width: 48rem;
    }

    time {
      height: 5rem;
      width: 5.5rem;

      padding: 0;

      border-radius: 4rem;
    }

    .event-description {
      max-width: 50ch;
    }
  }

  /* For wide-desktop: */
  @media only screen and (min-width: 1536px) {
  }
</style>
