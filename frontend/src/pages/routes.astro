---
// src/pages/routes.astro
import SchoolRoutesContainer from "../components/SchoolRoutesContainer.jsx";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Icon from "../components/Icon.astro";
import { PUBLIC_API_URL } from "astro:env/client";
import { readItem, readItems } from "@directus/sdk";
import directus from "../lib/directus";

// Function to fix UTF-8 encoding issues (when UTF-8 is incorrectly interpreted as Latin-1)
function fixEncoding(str: string | null | undefined): string {
  if (!str) return "";
  try {
    // Convert the string to bytes as if it was Latin-1, then decode as UTF-8
    const bytes = new TextEncoder().encode(str);
    const decoder = new TextDecoder("latin1");
    const latin1String = decoder.decode(bytes);
    const utf8Bytes = new Uint8Array(
      latin1String.split("").map((c) => c.charCodeAt(0))
    );
    return new TextDecoder("utf-8").decode(utf8Bytes);
  } catch (e) {
    // If conversion fails, return original string
    return str;
  }
}

// Recursively fix encoding in objects
function fixObjectEncoding(obj: any): any {
  if (typeof obj === "string") {
    return fixEncoding(obj);
  }
  if (Array.isArray(obj)) {
    return obj.map((item) => fixObjectEncoding(item));
  }
  if (obj && typeof obj === "object") {
    const fixed: any = {};
    for (const [key, value] of Object.entries(obj)) {
      fixed[key] = fixObjectEncoding(value);
    }
    return fixed;
  }
  return obj;
}

const schools = await directus.request(
  readItems("schools", {
    // @ts-expect-error: "*.*" is a valid Directus field selector
    fields: ["*", "*.*"],
  })
);

let routes: any[] = [];

routes = await directus.request(
  readItems("transport_routes", {
    // @ts-expect-error: "*.*" is a valid Directus field selector
    fields: ["*", "*.*"],
  })
);

// Fix encoding for all routes
routes = fixObjectEncoding(routes);

// Filter schools to only show those that have transport routes
const schoolsWithRoutes = schools.filter((school) =>
  routes.some((route) => route.school?.id === school.id)
);

console.log("Fetched routes:", JSON.stringify(routes[0], null, 2));
---

<style>
  @media (max-width: 700px) {
    :global(.routes-container-wrapper) {
      flex-direction: column !important;
    }
    :global(.sidebar-wrapper) {
      width: 100% !important;
      order: 2;
      padding: 0.5rem !important;
    }
    :global(.main-content-wrapper) {
      order: 1;
      padding: 0.5rem !important;
    }
  }
</style>

<Layout title="Percorsi di Trasporto">
  <Navbar current_view="routes" />
  <SchoolRoutesContainer
    client:only="react"
    schools={schoolsWithRoutes}
    routes={routes}
  />
</Layout>
